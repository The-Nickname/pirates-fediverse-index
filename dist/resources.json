    "ym-Universidad-Jorge-Tadeo-Lozano": {"id": "ym-Universidad-Jorge-Tadeo-Lozano", "type": "youthmappers", "locationSet": {"include": [[-74.0678, 4.6069]]}, "languageCodes": ["es"], "order": 4, "strings": {"community": "TadeoMappers", "communityID": "tadeomappers", "name": "TadeoMappers at Universidad Jorge Tadeo Lozano", "description": "YouthMappers chapter at Universidad Jorge Tadeo Lozano", "extendedDescription": "Students from Bogota passionate about mapping activities that support biodiversity. They focus on mapping trees and bringing these activities to schools, aiming to involve the entire community in environmental efforts.", "url": "mailto:ludwig.alvaradob@utadeo.edu.co?subject=Youth%20Mappers"}, "contacts": [{"name": "Ludwig Alvarado", "email": "ludwig.alvaradob@utadeo.edu.co"}, {"name": "Alejandro Franco", "email": "josea.francoc@utadeo.edu.co"}]},
